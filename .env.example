# =====================================================
# NAM TRUNG LOGISTICS (NTG1688) - CONFIGURATION
# =====================================================

# 1. SUPABASE (Database, Auth & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. CLOUDFLARE R2 STORAGE (Ảnh đơn hàng, phiếu xuất, hóa đơn, tờ khai)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=namtrung-media
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://media.nhapkhaunamtrung.com

# 3. AUTOMATION & PAYMENTS (VietQR / Nạp tiền tự động)
VIETQR_BANK_ID=ICB
VIETQR_ACCOUNT_NO=117634318888
VIETQR_ACCOUNT_NAME=CONG TY TNHH DICH VU VA THUONG MAI QUOC TE NAM TRUNG
VIETQR_TEMPLATE=compact
SEPAY_WEBHOOK_API_KEY=your-sepay-or-payos-webhook-secret

# 4. TELEGRAM / ZALO NOTIFICATIONS (Thông báo Realtime)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-chat-id

# 5. PUBLIC WEB URL
NEXT_PUBLIC_SITE_URL=https://nhapkhaunamtrung.com
